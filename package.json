{
  "name": "badger",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "imports": {
    "#badger-db": {
      "storybook": "./.storybook/badger-db.mock.ts",
      "default": "./src/app/db/badger-db.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "audit": "npm audit --audit-level=high",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:ui": "vitest run --project=storybook",
    "test:storybook-build": "node --test test/storybook-smoke.ts",
    "test:watch": "vitest",
    "test:install": "playwright install chromium",
    "validate": "npm run lint && npm run test && npm run build && npm run storybook:build",
    "link:db": "npm link coh-content-db",
    "link:hc": "npm link coh-content-db-homecoming",
    "link:all": "npm link coh-content-db coh-content-db-homecoming",
    "upgrade:db": "npm install --save coh-content-db@latest",
    "upgrade:hc": "npm install --save-dev coh-content-db-homecoming@latest",
    "upgrade:storybook": "npx storybook@latest upgrade",
    "push": "git push && git push --tags",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build && npm run test:storybook-build"
  },
  "repository": "https://github.com/n15g/badger",
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@loadingio/loading.css": "^3.2.1",
    "@mui/joy": "^5.0.0-beta.52",
    "axios": "^1.19.0",
    "coh-content-db": "^2.3.0",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "moment": "^2.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-error-boundary": "^6.1.3",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "shortid": "^2.2.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/shortid": "^2.2.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.11",
    "@vueless/storybook-dark-mode": "^10.0.8",
    "baseline-browser-mapping": "^2.11.15",
    "coh-content-db-homecoming": "^2.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-dom": "^5.18.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.6.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "terser": "^5.50.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false,
    "esbuild@0.28.2": true
  }
}
